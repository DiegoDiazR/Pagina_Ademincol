# ─── Configuración del backend de formularios Ademincol ───
# Copia este archivo como ".env" (en la carpeta backend/) y llena los valores.
# El backend se arranca con:  node --env-file=.env server.js   (Node 22+)
# NUNCA subas el .env real a git (ya está protegido por backend/.gitignore).

# ── Servidor ──
PORT=3001
# Token secreto para los endpoints /api/admin/*  (header X-Admin-Token)
ADMIN_TOKEN=cambia-esto-por-un-token-largo-y-aleatorio

# ── Correo SMTP — Microsoft 365 ──
# Pon MAIL_ENABLED=false para desactivar el envío (los formularios igual se guardan).
MAIL_ENABLED=true
SMTP_HOST=smtp.office365.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=no-reply@ademincol.com.co
# App Password del buzón (requiere MFA + SMTP AUTH habilitado en el tenant M365)
SMTP_PASS=
MAIL_FROM=Ademincol <no-reply@ademincol.com.co>
MAIL_TO_COTIZACION=comercial1@ademincol.com.co
MAIL_TO_PQRSF=pqrsf@ademincol.com.co
# Copia oculta opcional (ej. gerencia). Déjalo vacío si no aplica.
MAIL_BCC=
