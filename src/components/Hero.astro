---
export interface Crumb {
	label: string;
	href?: string;
}

export interface Props {
	variant?: 'red' | 'dark' | 'light';
	eyebrow?: string;
	breadcrumb?: Crumb[];
	title: string;
	subtitle?: string;
	bgImage?: string;
	align?: 'center' | 'left';
}

const {
	variant = 'red',
	eyebrow,
	breadcrumb,
	title,
	subtitle,
	bgImage,
	align,
} = Astro.props;

const hasRight = Astro.slots.has('right');
const finalAlign: 'center' | 'left' = align ?? (hasRight ? 'left' : 'center');
---
<section
	class:list={[
		'hero-internal',
		`hero-internal--${variant}`,
		hasRight && 'hero-internal--split',
		finalAlign === 'left' && 'hero-internal--align-left',
	]}
>
	{bgImage && (
		<div class="hero-internal__bg" style={`background-image:url('${bgImage}')`}></div>
	)}
	<div class="hero-internal__inner">
		<div class="hero-internal__main">
			{breadcrumb && breadcrumb.length > 0 && (
				<nav class="hero-internal__crumbs" aria-label="Breadcrumb">
					{breadcrumb.map((c, i) => (
						<>
							{c.href ? <a href={c.href}>{c.label}</a> : <span>{c.label}</span>}
							{i < breadcrumb.length - 1 && <span class="sep"> / </span>}
						</>
					))}
				</nav>
			)}
			{eyebrow && <span class="hero-internal__eyebrow">{eyebrow}</span>}
			<h1 class="hero-internal__title" set:html={title} />
			{subtitle && <p class="hero-internal__sub">{subtitle}</p>}
			<slot />
		</div>
		{hasRight && (
			<div class="hero-internal__right">
				<slot name="right" />
			</div>
		)}
	</div>
</section>

<style is:global>
	/* ──────────────────────────────────────────────────────────
	   HERO INTERNO ESTANDARIZADO — 48vh, grid 2-col opcional
	   Usado por: nuestra-empresa, contactenos, servicios,
	   sostenibilidad, ServiceLayout (10 servicios individuales)
	   ────────────────────────────────────────────────────────── */
	.hero-internal {
		position: relative;
		min-height: 48vh;
		display: flex;
		align-items: center;
		overflow: hidden;
	}
	.hero-internal--red {
		background: linear-gradient(135deg, #cf2e2e 0%, #8b1a1a 100%);
		color: #fff;
	}
	.hero-internal--dark {
		background-color: #3d3d3d;
		color: #fff;
	}
	.hero-internal--light {
		background: #f7f8f9;
		color: #1a1a1a;
	}
	.hero-internal__bg {
		position: absolute;
		inset: 0;
		background-size: cover;
		background-position: center;
		background-repeat: no-repeat;
		opacity: 0.25;
		z-index: 1;
		pointer-events: none;
	}
	.hero-internal__inner {
		position: relative;
		z-index: 2;
		width: 100%;
		max-width: 1300px;
		margin: 0 auto;
		padding: 100px 40px 60px;
		display: grid;
		grid-template-columns: 1fr;
		gap: 60px;
		align-items: center;
		text-align: center;
	}
	.hero-internal--align-left .hero-internal__inner { text-align: left; }
	.hero-internal--split .hero-internal__inner {
		grid-template-columns: 1fr 1fr;
		text-align: left;
	}
	.hero-internal__main {
		max-width: 720px;
		margin: 0 auto;
		min-width: 0;
	}
	.hero-internal--align-left .hero-internal__main,
	.hero-internal--split .hero-internal__main {
		margin: 0;
	}

	/* Breadcrumb */
	.hero-internal__crumbs {
		font-size: 13px;
		opacity: 0.8;
		margin-bottom: 18px;
	}
	.hero-internal__crumbs a,
	.hero-internal__crumbs span {
		color: inherit;
		text-decoration: none;
	}
	.hero-internal__crumbs a:hover { text-decoration: underline; }
	.hero-internal__crumbs .sep { margin: 0 2px; opacity: 0.6; }

	/* Eyebrow */
	.hero-internal__eyebrow {
		display: inline-block;
		text-transform: uppercase;
		letter-spacing: 3px;
		font-weight: 700;
		font-size: 13px;
		margin-bottom: 20px;
	}
	.hero-internal--red .hero-internal__eyebrow { color: #fff; opacity: 0.9; }
	.hero-internal--dark .hero-internal__eyebrow { color: #cf2e2e; letter-spacing: 4px; font-size: 14px; }
	.hero-internal--light .hero-internal__eyebrow {
		padding: 6px 14px;
		background: rgba(74, 121, 64, 0.12);
		color: #4A7940;
		font-size: 12px;
		letter-spacing: 2px;
		border-radius: 999px;
		margin-bottom: 24px;
	}

	/* Title */
	.hero-internal__title {
		font-family: 'Barlow', sans-serif;
		font-size: clamp(32px, 5.5vw, 54px);
		font-weight: 800;
		line-height: 1.1;
		margin: 0 0 22px;
	}
	.hero-internal--red .hero-internal__title {
		text-transform: uppercase;
		letter-spacing: 1px;
	}
	.hero-internal--light .hero-internal__title { color: #1a1a1a; }

	/* Subtitle */
	.hero-internal__sub {
		font-size: 17px;
		line-height: 1.6;
		opacity: 0.9;
		margin: 0 auto;
		max-width: 600px;
	}
	.hero-internal--align-left .hero-internal__sub,
	.hero-internal--split .hero-internal__sub {
		margin-left: 0;
		margin-right: 0;
	}
	.hero-internal--light .hero-internal__sub { color: #555; opacity: 1; }

	/* Right column */
	.hero-internal__right {
		display: flex;
		flex-direction: column;
		gap: 22px;
		min-width: 0;
	}

	/* Responsive */
	@media (max-width: 768px) {
		.hero-internal {
			min-height: auto;
		}
		.hero-internal__inner {
			padding: 90px 24px 60px;
			gap: 40px;
		}
		.hero-internal--split .hero-internal__inner {
			grid-template-columns: 1fr;
			text-align: center;
		}
		.hero-internal--split .hero-internal__main {
			margin: 0 auto;
		}
		.hero-internal--split .hero-internal__sub {
			margin-left: auto;
			margin-right: auto;
		}
	}
</style>
