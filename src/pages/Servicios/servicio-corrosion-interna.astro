---
import ServiceLayout from '../../layouts/ServiceLayout.astro';

const IMG_BASE = '/css/media/09.Monitoreo y Evaluación de Corrosión Interna';

const galeria = [
	{ src: `${IMG_BASE}/Corrosion_interna_1.jpg`, alt: 'Monitoreo de corrosión interna', pos: 'center top' },
	{ src: `${IMG_BASE}/CUPONES-3.jpg`, alt: 'Evaluación de cupones de corrosión', pos: 'center bottom' },
	{ src: `${IMG_BASE}/Facilidad.jpg`, alt: 'Instalaciones de análisis', fit: 'contain' },
];

const capacidades = [
	{ titulo: 'Análisis Microbiológico en Aguas', detalle: 'Identificación de bacterias sulfato-reductoras y otros microorganismos asociados a la corrosión.' },
	{ titulo: 'Análisis Fisicoquímicos de Crudos', detalle: 'Caracterización del fluido para diagnóstico de mecanismos de corrosión.' },
	{ titulo: 'Análisis de Residuos de Raspadores', detalle: 'Evaluación de depósitos retirados durante operaciones de raspado de líneas.' },
	{ titulo: 'Análisis Cromatográficos', detalle: 'Cromatografía de gases y líquidos para caracterización del fluido.' },
	{ titulo: 'Análisis de Gases (In-Situ)', detalle: 'Mediciones puntuales en campo para validación de condiciones operativas.' },
	{ titulo: 'Monitoreo en Residuo de Inhibidor', detalle: 'Verificación de la dosificación efectiva de inhibidor en el sistema.' },
	{ titulo: 'Instalación y Retiro de Cupones', detalle: 'Servicio operativo en línea para cupones de corrosión.' },
	{ titulo: 'Evaluación Gravimétrica de Cupones', detalle: 'Cálculo de tasas de corrosión por pérdida de masa, evaluación de incrustaciones.' },
	{ titulo: 'Evaluación de Biocupones', detalle: 'Cuantificación de biofilm y carga microbiana asociada.' },
	{ titulo: 'Diagnóstico de Mecanismos de Corrosión Interna', detalle: 'Identificación de los mecanismos activos en el sistema.' },
	{ titulo: 'Estrategia Química Tailor Made', detalle: 'Diseño y ejecución de estrategias químicas personalizadas para gestión de corrosión, incrustaciones y depósitos.' },
	{ titulo: 'Inteligencia de Datos y Modelos Predictivos', detalle: 'Analítica avanzada para anticipar tendencias que afecten la productividad.' },
	{ titulo: 'Hidrogeoquímica — Diagnóstico y Proyección', detalle: 'Evaluación química del agua para comprender procesos en el yacimiento y la operación.' },
	{ titulo: 'Rehabilitación de Tuberías y Tanques', detalle: 'Soluciones integrales para mitigación y reparación de activos afectados por corrosión interna.' },
];
---
<ServiceLayout
	title="Monitoreo y Evaluación de Corrosión Interna - Ademincol SA"
	description="Monitoreo de corrosión interna en sistemas de proceso: análisis fisicoquímico, microbiológico, cromatografía, gases in-situ, cupones y biocupones, química e integridad."
	canonical="https://ademincol.com.co/servicios/corrosion-interna"
	heroTitle="Monitoreo y Evaluación de Corrosión Interna"
	heroSub="Servicio especializado para la evaluación de mecanismos de daño por corrosión interna en sistemas de proceso, integrando análisis del fluido, monitoreo y química preventiva."
	breadcrumb="Corrosión Interna"
>
	<section slot="gallery" class="service-gallery-section">
		<div class="service-gallery-grid">
			{galeria.map((g) => (
				<div class="gallery-image">
					<img src={g.src} alt={g.alt} style={`object-fit: ${g.fit ?? 'cover'}; object-position: ${g.pos ?? 'center'}`} loading="lazy" />
				</div>
			))}
		</div>
	</section>

	<h2>Capacidades del Servicio</h2>
	<div class="service-capabilities-grid">
		{capacidades.map((c) => (
			<div class="capability-item">
				<i class="fas fa-check-circle"></i>
				<span><strong>{c.titulo}</strong> — {c.detalle}</span>
			</div>
		))}
	</div>

</ServiceLayout>
